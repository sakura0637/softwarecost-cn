{
  "name": "software-cost-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "check:perm": "node scripts/check_permissions.mjs",
    "check:imports": "node scripts/check_imports.mjs server",
    "check:vue": "node scripts/check_vue.mjs",
  "check:om": "esbuild scripts/om_selftest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/om_selftest.mjs --external:pg --external:bcryptjs --external:xlsx --log-level=warning && node node_modules/.cache/om_selftest.mjs",
  "check:dbsql": "node scripts/check_dbsql.mjs",
  "check:audit": "esbuild scripts/check_audit.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check_audit.mjs --external:pg --external:bcryptjs --log-level=warning && node node_modules/.cache/check_audit.mjs",
  "check:enums": "esbuild scripts/check_enums.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check_enums.mjs --external:pg --external:bcryptjs --log-level=warning && node node_modules/.cache/check_enums.mjs",
  "check:pricing": "esbuild scripts/pricing_selftest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/pricing_selftest.mjs --external:pg --external:bcryptjs --log-level=warning && node node_modules/.cache/pricing_selftest.mjs",
  "check": "npm run check:imports && npm run check:vue && npm run check:perm && npm run check:dbsql && npm run check:enums && npm run check:audit && npm run check:pricing && npm run check:om"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "echarts": "^5.6.0",
    "jose": "^6.2.10",
    "mammoth": "^1.12.1",
    "nuxt": "^3.13.0",
    "pg": "^8.13.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.12.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13"
  }
}
